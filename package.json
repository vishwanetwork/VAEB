{
  "name": "vaeb",
  "version": "0.1.0",
  "private": true,
  "description": "Verified Agent Execution Bundle — composable infrastructure for AI agents to touch on-chain assets",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "concurrently -n mcp,server,frontend -c blue,green,magenta \"npm run dev:mcp\" \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:mcp": "tsc --watch --project packages/mcp-server/tsconfig.json",
    "dev:server": "npm run dev -w @vaeb/server",
    "dev:frontend": "npm run dev -w @vaeb/frontend",
    "demo": "node scripts/demo.js"
  },
  "keywords": [
    "vaeb",
    "erc-8150",
    "erc-8004",
    "x402",
    "mcp",
    "zk-proofs",
    "agent-wallet"
  ],
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "concurrently": "^9.2.1",
    "hardhat": "^2.28.6",
    "solc": "^0.8.24"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "dotenv": "^17.3.0"
  }
}
