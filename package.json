{
  "name": "vaeb",
  "version": "0.1.0",
  "private": true,
  "description": "Verified Agent Execution Bundle — composable infrastructure for AI agents to touch on-chain assets",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "build:sdk": "npm run build -w @vaeb/intent-sdk",
    "build:mcp": "npm run build -w @vaeb/mcp-server",
    "build:prover": "npm run build -w @vaeb/prover-service",
    "demo": "node scripts/demo.js"
  },
  "keywords": [
    "vaeb",
    "erc-8150",
    "erc-8004",
    "x402",
    "mcp",
    "zk-proofs",
    "agent-wallet"
  ],
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "hardhat": "^2.28.6",
    "solc": "^0.8.24"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "dotenv": "^17.3.0"
  }
}
