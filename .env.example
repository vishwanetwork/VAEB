# VAEB Configuration
# Copy to .env and fill in your values

# ─── Wallets ──────────────────────────────────────────────────

# Owner wallet (the user who controls the AgentWallet)
OWNER_PRIVATE_KEY=0x<your-owner-private-key>
OWNER_ADDRESS=0x<your-owner-address>
AGENT_WALLET_ADDRESS=0x<your-agent-wallet-contract-address>

# Agent wallet (the AI agent authorized to submit transactions)
AGENT_PRIVATE_KEY=0x<your-agent-private-key>

# ─── LLM Provider ────────────────────────────────────────────

# Options: openai | deepseek | 0g
LLM_PROVIDER=0g
# LLM_MODEL=deepseek-chat  # optional: override model name

# OpenAI (GPT-4o-mini)
OPENAI_API_KEY=sk-<your-openai-api-key>

# DeepSeek
DEEPSEEK_API_KEY=sk-<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 0G Decentralized AI Serving (set LLM_PROVIDER=0g to use)
# Uses AGENT_PRIVATE_KEY for 0G wallet — fund with A0GI at https://faucet.0g.ai
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# ZG_PROVIDER_ADDRESS=0x...  # optional: specific 0G provider (auto-discovers if not set)

# ─── Networks ─────────────────────────────────────────────────

# Default chain to use (base_sepolia | kite_testnet | adi_testnet)
DEFAULT_CHAIN=kite_testnet

# Base Sepolia (Chain ID 84532)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Kite AI Testnet (Chain ID 2368)
# Fund at: https://faucet.gokite.ai
KITE_TESTNET_RPC_URL=https://rpc-testnet.gokite.ai
# Filled in automatically by: node scripts/deploy-kite.js
KITE_AGENT_WALLET_ADDRESS=
KITE_MOCK_USDC_ADDRESS=

# ADI Network AB Testnet (Chain ID 99999)
ADI_TESTNET_RPC_URL=https://rpc.ab.testnet.adifoundation.ai/
# Filled in automatically by: node scripts/deploy-adi.js
ADI_AGENT_WALLET_ADDRESS=
ADI_MOCK_USDC_ADDRESS=

# ─── Third-Party APIs ────────────────────────────────────────

# Thirdweb (wallet connect)
THIRDWEB_CLIENT_ID=<your-thirdweb-client-id>
THIRDWEB_SECRET_KEY=<your-thirdweb-secret-key>

# Uniswap Trading API (for ETH → USDC swap on Base Sepolia)
UNISWAP_API_KEY=<your-uniswap-api-key>

# ─── Runtime ──────────────────────────────────────────────────

# Set to 1 to auto-execute intents after signing (skip manual approval)
RUN_EXECUTE_INTENT=1
