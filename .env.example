# VAEB Configuration — Base Sepolia
# Copy to .env and fill in your values

# Owner wallet (the user who controls the AgentWallet)
OWNER_PRIVATE_KEY=0x<your-owner-private-key>
OWNER_ADDRESS=0x<your-owner-address>

# Agent wallet (the AI agent authorized to submit transactions)
AGENT_PRIVATE_KEY=0x<your-agent-private-key>

# Network
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
