# VAEB Configuration — Base Sepolia
# Copy to .env and fill in your values

# Owner wallet (the user who controls the AgentWallet)
OWNER_PRIVATE_KEY=0x<your-owner-private-key>
OWNER_ADDRESS=0x<your-owner-address>

# Agent wallet (the AI agent authorized to submit transactions)
AGENT_PRIVATE_KEY=0x<your-agent-private-key>

# LLM Provider (openai | deepseek | 0g)
LLM_PROVIDER=openai

# OpenAI (GPT-4o-mini for AI agent)
OPENAI_API_KEY=sk-<your-openai-api-key>

# 0G Decentralized AI Serving (set LLM_PROVIDER=0g to use)
# Uses AGENT_PRIVATE_KEY for 0G wallet — fund with A0GI at https://faucet.0g.ai
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# ZG_PROVIDER_ADDRESS=0x...  # optional: specific 0G provider (auto-discovers if not set)

# Network — Base Sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Network — Kite AI Testnet (Chain ID 2368)
# Same OWNER_PRIVATE_KEY / AGENT_PRIVATE_KEY — just fund them at https://faucet.gokite.ai
KITE_TESTNET_RPC_URL=https://rpc-testnet.gokite.ai
# Filled in automatically by: node scripts/deploy-kite.js
KITE_AGENT_WALLET_ADDRESS=
KITE_MOCK_USDC_ADDRESS=
