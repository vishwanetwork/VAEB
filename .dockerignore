# VAEB Docker Ignore File
# Files and directories to exclude from Docker build context

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Keep package-lock.json for npm ci
# package-lock.json
yarn.lock

# Environment files (except .env.example for reference)
.env
.env.local
.env.*.local
!.env.example

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Testing
coverage/
.nyc_output/
*.test.ts
*.test.js
*.spec.ts
*.spec.js
tests/

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
docs/
doc/
README*
LICENSE*
CHANGELOG*

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Foundry/Hardhat artifacts
contracts/cache/
contracts/out/
contracts/broadcast/
contracts/lib/

# Circuit build artifacts (keep source, ignore large build files)
circuits/build/*.zkey
circuits/build/*.ptau
circuits/build/*.r1cs

# Misc
*.pid
*.seed
*.pid.lock
